PORT=3001
DATABASE_PATH=./data/dealership.db
# Replace this with a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Keep socket locally. Use railway only behind Railway's HTTP edge.
CLIENT_IP_SOURCE=socket
# These credentials are used ONLY by the explicit seed command.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_CUSTOMER_EMAIL=customer@demo.local
SEED_CUSTOMER_PASSWORD=CustomerDemo123!
